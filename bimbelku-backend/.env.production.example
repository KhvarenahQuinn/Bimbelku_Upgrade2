# ==============================================================================
# Application & Environment (Staging / Production)
# ==============================================================================
APP_NAME=BimbelKu
APP_ENV=production
# Jalankan `php artisan key:generate` di server deployment untuk mengisi APP_KEY.
APP_KEY=
# Opsional: daftar key lama dipisahkan koma saat rotasi APP_KEY (Laravel 13).
APP_PREVIOUS_KEYS=
# Wajib false di produksi agar stack trace dan environment tidak bocor.
APP_DEBUG=false
APP_URL=https://api.example.com

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database
BCRYPT_ROUNDS=12

# ==============================================================================
# Frontend, CORS & Sanctum
# ==============================================================================
FRONTEND_URL=https://www.example.com
# Daftar origin frontend yang diizinkan (pisahkan dengan koma, jangan gunakan '*').
FRONTEND_ORIGINS=https://www.example.com
CORS_MAX_AGE=600

# Hostname SPA yang diizinkan menerima cookie stateful Sanctum (tanpa skema).
SANCTUM_STATEFUL_DOMAINS=www.example.com,example.com
# Jangan pasang batas global 720 menit: setiap token login sudah mempunyai expires_at.
# Batas global akan memotong sesi "ingat perangkat ini" (30 hari).
# SANCTUM_TOKEN_EXPIRATION=
# Prefix token untuk secret scanning di repositori publik/privat.
SANCTUM_TOKEN_PREFIX=bimbelku_prod_

# ==============================================================================
# Admin, Policy & Feature Flags
# ==============================================================================
POLICY_VERSION=2026-07-29
PRIMARY_ADMIN_EMAIL=
# Hanya dipakai oleh DatabaseSeeder / AdminSeeder saat inisialisasi awal.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Wajib false di produksi agar akun demo tidak dibuat.
SEED_DEMO_USERS=false

FEATURE_TEACHER_REPLACEMENT=true
# Wajib false di produksi (provider akan menolak boot bila true).
# Pencairan tutor membutuhkan integrasi BankAccountNameVerifier; mengisi
# XENDIT_SECRET_KEY tidak otomatis mengaktifkan pemeriksaan nama bank.
PAYOUT_BANK_NAME_VERIFICATION_STUB=false

# ==============================================================================
# Database
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ==============================================================================
# Session, Cache, Queue & Storage
# ==============================================================================
# Gunakan database (default) atau redis bila layanan Redis tersedia di produksi.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Kosongkan/null untuk domain tunggal; isi .example.com jika berbagi subdomain.
SESSION_DOMAIN=null
# Wajib true di produksi (HTTPS).
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Sesi browser persisten: admin 12 jam; murid/tutor dapat mengingat perangkat 30 hari.
AUTH_SESSION_COOKIE=bimbelku_session
AUTH_SESSION_STANDARD_MINUTES=720
AUTH_SESSION_REMEMBERED_MINUTES=43200
AUTH_SESSION_ADMIN_MINUTES=720
AUTH_SESSION_REFRESH_THRESHOLD_MINUTES=10080

# Gunakan database atau redis di produksi; pastikan queue worker berjalan.
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
# Gunakan local atau s3 (jika memakai object storage eksternal).
FILESYSTEM_DISK=local

# ==============================================================================
# Logging
# ==============================================================================
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
# Retention (hari) per channel log domain. Semua channel memakai driver 'daily'
# dengan file di storage/logs/<domain>/<domain>-YYYY-MM-DD.log.
LOG_PAYMENTS_DAYS=365
LOG_PAYOUTS_DAYS=365
LOG_WEBHOOKS_DAYS=365
LOG_SECURITY_DAYS=180
LOG_MAIL_DAYS=14

# ==============================================================================
# Mail (SMTP)
# ==============================================================================
# Produksi WAJIB memakai smtp (mis. Brevo: smtp-relay.brevo.com).
MAIL_MAILER=smtp
# Saluran fallback bila MAIL_MAILER=log (tidak dipakai saat MAIL_MAILER=smtp).
MAIL_LOG_CHANNEL=mail
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# Google OAuth
# ==============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/api/auth/google/callback

# ==============================================================================
# Xendit Payment Gateway & Payouts
# ==============================================================================
# Isi key TEST dahulu untuk pengujian HTTPS. Ganti ke LIVE hanya setelah lulus.
# Semua secret berikut hanya di backend, tidak boleh memakai awalan VITE_.
XENDIT_ENABLED=false
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_COUNTRY=ID
XENDIT_CURRENCY=IDR
XENDIT_SUCCESS_URL=https://www.example.com/payment?gateway=success
XENDIT_CANCEL_URL=https://www.example.com/payment?gateway=cancelled
# Dibutuhkan untuk payout tutor. Secret key harus memiliki izin MONEY-OUT.
XENDIT_PAYOUT_API_VERSION=2025-09-01
# Payments API v3 refunds accept only this api-version value.
XENDIT_REFUND_API_VERSION=2024-11-11

# ==============================================================================
# Cloudflare Turnstile Anti-Bot
# ==============================================================================
# Proteksi untuk /login, /admin/login, /register, dan /forgot-password.
# Wajib diisi bersama VITE_TURNSTILE_SITE_KEY di frontend saat produksi.
TURNSTILE_ENABLED=true
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
TURNSTILE_TIMEOUT_SECONDS=5
