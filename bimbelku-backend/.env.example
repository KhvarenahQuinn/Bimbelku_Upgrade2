# ==============================================================================
# Application & Environment
# ==============================================================================
APP_NAME=BimbelKu
# Lokal: local | Staging/Produksi: staging atau production
APP_ENV=local
# Jalankan `php artisan key:generate` untuk mengisi APP_KEY.
APP_KEY=
# Opsional: daftar key lama dipisahkan koma saat rotasi APP_KEY (Laravel 13).
APP_PREVIOUS_KEYS=
# Wajib false di staging/produksi agar stack trace tidak bocor. Ubah ke true hanya di lokal.
APP_DEBUG=false
# Lokal: http://127.0.0.1:8000 | Staging/Produksi: https://api.example.com
APP_URL=http://127.0.0.1:8000

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database
BCRYPT_ROUNDS=12

# ==============================================================================
# Frontend, CORS & Sanctum
# ==============================================================================
# Lokal: http://127.0.0.1:8080 | Staging/Produksi: https://example.com
FRONTEND_URL=http://127.0.0.1:8080
# Daftar origin frontend yang diizinkan (pisahkan dengan koma, jangan gunakan '*').
FRONTEND_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
CORS_MAX_AGE=600

# Hostname SPA yang diizinkan menerima cookie stateful Sanctum (tanpa skema).
# Staging/Produksi: isi domain frontend final, mis. example.com,www.example.com
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8080,127.0.0.1,127.0.0.1:8000,127.0.0.1:8080
# Biarkan SANCTUM_TOKEN_EXPIRATION tidak disetel: setiap token login punya masa aktif sendiri.
# Pembatasan global akan memotong sesi "ingat perangkat ini" (30 hari).
# SANCTUM_TOKEN_EXPIRATION=
# Opsional: prefix token untuk secret scanning (mis. bmk_ di produksi).
SANCTUM_TOKEN_PREFIX=

# ==============================================================================
# Admin, Policy & Feature Flags
# ==============================================================================
POLICY_VERSION=2026-07-29
PRIMARY_ADMIN_EMAIL=admin@bimbelku.com
# Hanya dipakai oleh DatabaseSeeder / AdminSeeder saat inisialisasi.
SEED_ADMIN_EMAIL=admin@bimbelku.com
SEED_ADMIN_PASSWORD=
# Wajib false di staging/produksi agar akun demo tidak dibuat.
SEED_DEMO_USERS=false

FEATURE_TEACHER_REPLACEMENT=true
# HANYA untuk local/testing. Membuat pencairan bisa dikirim tanpa lookup nama pemilik
# rekening dari bank. Wajib false di produksi (provider akan menolak boot bila true).
PAYOUT_BANK_NAME_VERIFICATION_STUB=false

# ==============================================================================
# Database
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bimbelku
DB_USERNAME=root
DB_PASSWORD=

# ==============================================================================
# Session, Cache, Queue & Storage
# ==============================================================================
# Gunakan database (default) atau redis bila layanan Redis tersedia di produksi.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Kosongkan/null untuk domain tunggal; isi .example.com jika berbagi subdomain.
SESSION_DOMAIN=null
# Wajib true di staging/produksi (HTTPS); set false hanya untuk HTTP lokal.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Sesi browser persisten: admin 12 jam; murid/tutor dapat mengingat perangkat 30 hari.
AUTH_SESSION_COOKIE=bimbelku_session
AUTH_SESSION_STANDARD_MINUTES=720
AUTH_SESSION_REMEMBERED_MINUTES=43200
AUTH_SESSION_ADMIN_MINUTES=720
AUTH_SESSION_REFRESH_THRESHOLD_MINUTES=10080

# Gunakan database atau redis di staging/produksi; pastikan queue worker berjalan.
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
# Lokal: local | Staging/Produksi: local atau s3 (jika memakai object storage eksternal).
FILESYSTEM_DISK=local

# ==============================================================================
# Logging
# ==============================================================================
LOG_CHANNEL=stack
# Lokal: single | Staging/Produksi: daily (dengan rotasi LOG_DAILY_DAYS).
LOG_STACK=single
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
# Lokal: debug | Staging/Produksi: info atau warning.
LOG_LEVEL=info
# Retention (hari) per channel log domain. Semua channel memakai driver 'daily'
# dengan file di storage/logs/<domain>/<domain>-YYYY-MM-DD.log.
LOG_PAYMENTS_DAYS=365
LOG_PAYOUTS_DAYS=365
LOG_WEBHOOKS_DAYS=365
LOG_SECURITY_DAYS=180
LOG_MAIL_DAYS=14

# ==============================================================================
# Mail (Brevo SMTP)
# ==============================================================================
# Lokal: log | Staging/Produksi: WAJIB smtp.
MAIL_MAILER=log
# Saluran log untuk driver log: 'mail' menulis ke storage/logs/mail/mail-YYYY-MM-DD.log.
MAIL_LOG_CHANNEL=mail
MAIL_SCHEME=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Staging/Produksi: ganti ke domain pengirim terverifikasi (mis. noreply@example.com).
MAIL_FROM_ADDRESS="noreply@bimbelku.local"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# Google OAuth
# ==============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Lokal: http://127.0.0.1:8000/api/auth/google/callback | Produksi: https://api.example.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback

# ==============================================================================
# Xendit Payment Gateway & Payouts
# ==============================================================================
# Semua uang masuk memakai hosted checkout Xendit. Isi dengan key TEST lebih
# dahulu; jangan pernah menaruh secret key pada Vite/frontend.
XENDIT_ENABLED=false
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_COUNTRY=ID
XENDIT_CURRENCY=IDR
XENDIT_SUCCESS_URL=http://127.0.0.1:8080/payment?gateway=success
XENDIT_CANCEL_URL=http://127.0.0.1:8080/payment?gateway=cancelled
# Dibutuhkan untuk payout tutor. Secret key harus memiliki izin MONEY-OUT.
XENDIT_PAYOUT_API_VERSION=2025-09-01
# Payments API v3 refunds accept only this api-version value.
XENDIT_REFUND_API_VERSION=2024-11-11

# ==============================================================================
# Cloudflare Turnstile Anti-Bot
# ==============================================================================
# Proteksi untuk /login, /admin/login, /register, dan /forgot-password.
# Staging/Produksi: set true dan isi TURNSTILE_SECRET_KEY (+ VITE_TURNSTILE_SITE_KEY di frontend).
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
TURNSTILE_TIMEOUT_SECONDS=5
