# ==============================================================================
# Frontend (Vite + React) Environment Variables
# PERINGATAN: Semua variabel berawalan VITE_ dibundel ke client-side JS.
# Jangan pernah menaruh secret key (Xendit, Google, Turnstile secret, dll.) di sini.
# ==============================================================================

# Base URL API backend.
# Lokal (via Vite proxy): /api | Staging/Produksi: /api (same-origin) atau https://api.example.com/api
VITE_API_BASE_URL=/api

# Domain publik HTTPS final untuk canonical URL, prerender meta, dan sitemap deployment.
# Contoh staging/produksi: https://bimbelcerdas.com
VITE_SITE_URL=

# Build-time only (dibaca oleh scripts/generate-sitemap.mjs via process.env, tidak dibundel ke browser).
# Isi URL publik /api/learning-catalog?compact=1 saat build deployment agar semua mapel aktif masuk sitemap.
SEO_PROGRAM_API=

# Cloudflare Turnstile Site Key (public key).
# Lokal/Test: biarkan kosong agar verifikasi dimatikan.
# Staging/Produksi: WAJIB diisi dan dipasangkan dengan TURNSTILE_SECRET_KEY di backend.
VITE_TURNSTILE_SITE_KEY=

# HANYA untuk pratinjau desain pembayaran di localhost/127.0.0.1 (`npm run build:payment-preview`).
# Wajib false di staging/produksi.
VITE_PAYMENT_DESIGN_PREVIEW=false
